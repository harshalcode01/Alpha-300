class Solution:
    def rotateString(self, s: str, goal: str) -> bool:
        x = len(s)
        if x != len(goal):
            return False
        if x == 0:
            return True
        for k in range(x):
            match = True
            for j in range(x):
                if s[(k + j) % x] != goal[j]:
                    match = False
                    break
            if match:
                return True
        return False
