class Solution:
    def strStr(self, haystack: str, needle: str) -> int:
        x = len(haystack)
        y = len(needle)

        if y == 0:
            return 0

        for i in range(x - y + 1):
            j = 0
            while j < y and haystack[i + j] == needle[j]:
                j += 1
            if j == y:
                return i

        return -1
