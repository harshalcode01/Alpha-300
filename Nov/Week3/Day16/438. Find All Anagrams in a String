def find_anagrams(s, p):
    result = []
    x = len(s)
    y = len(p)
    if x > y:
        return result
    need = {}
    for ch in p:
        if ch in need:
            need[ch] = need[ch] + 1
        else:
            need[ch] = 1
    window = {}
    for i in range(x):
        ch = s[i]
        if ch in window:
            window[ch] = window[ch] + 1
        else:
            window[ch] = 1
        if i >= y:
            old = s[i - y]
            window[old] = window[old] - 1
            if window[old] == 0:
                del window[old]
        if window == need:
            result.append(i - y+ 1)
    return result
